# --- Secrets and credentials (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
service-account*.json
secrets/

# --- Python environments and caches ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/

# --- Runtime data: local databases, customer uploads, job sandboxes ---
storage/*
!storage/.gitkeep
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# --- Logs and temporary files ---
*.log
logs/
tmp/
*.tmp
*.bak
*.swp

# --- Frontend dependencies and build output (if a UI is added) ---
node_modules/
.next/
out/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
