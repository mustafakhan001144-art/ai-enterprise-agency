# Copy to .env (never commit .env) and fill in real values locally.
#   Linux/macOS:  cp .env.example .env
#   PowerShell:   Copy-Item .env.example .env
# All gateway settings use the AGENCY_ prefix (see api/settings.py).

AGENCY_ENVIRONMENT=development

# Runtime data. Relative paths resolve from the directory you start uvicorn in.
AGENCY_STORAGE_ROOT=storage
AGENCY_DATABASE_PATH=storage/database.db

# Stripe: use TEST-mode keys for development (dashboard.stripe.com/test/apikeys).
# The placeholders below are enough to run the dashboard locally with a demo account
# (python -m api.admin demo); real keys are only needed to test billing webhooks.
AGENCY_STRIPE_API_KEY=sk_test_replace_me
# From `stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe`
AGENCY_STRIPE_WEBHOOK_SECRET=whsec_replace_me
# JSON map of Stripe Price ID -> monthly credit quota
AGENCY_PLAN_CREDITS={"price_replace_me": 1000}

# Limits (defaults shown)
AGENCY_MAX_REQUEST_BYTES=5242880
AGENCY_FORENSICS_BYTES_PER_CREDIT=65536
AGENCY_ARCHEOLOGY_AUDIT_CREDITS=10

# Optional plain-language client summary written by Claude (core/llm.py).
# Off by default: every report is fully deterministic until you set both lines below.
AGENCY_LLM_PROVIDER=none
# AGENCY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AGENCY_LLM_MODEL=claude-opus-5-5
# AGENCY_LLM_EFFORT=low
# With the model on, consult this many routed Agency Agents specialists per job (0 = none).
# AGENCY_LLM_MAX_CONSULTS=3

# Your installed Agency Agents (msitarzewski/agency-agents). When set, an installed file
# replaces the vendored catalog copy with the same name. Claude Code installs to:
#   Windows: C:\Users\<you>\.claude\agents     macOS/Linux: ~/.claude/agents
# scripts/run-local.ps1 sets this for you when that folder exists.
# AGENCY_INSTALLED_AGENTS_DIR=~/.claude/agents
